# Copy to .env; Node's --env-file-if-exists option loads it through npm scripts.
# Use Node 24. Start the native runtime with npm run runtime:start, then npm start.
PORT=3210
BOT_NATIVE_PORT=4331
BOT_REDIS_PORT=6392
BOT_METRICS_PORT=9492
BOT_RUNTIME_DATA_DIR=./data/native
# Members use native CLI authentication or Clowder AI managed accounts.
# There is no demo mode or fallback engine. Never point this at an existing Clowder deployment.
