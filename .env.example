# Copy to .env; Node's --env-file-if-exists option loads it through npm scripts.
# Defaults require no external account or CLI. Choose live mode in the UI.
PORT=3210
CLOWDER_DATA_DIR=./data

# In Settings choose apiKeyEnv=OPENAI_API_KEY and enter your service's base URL.
# For local compatible servers that do not require authentication, set a dummy value.
OPENAI_API_KEY=

# CLI processes use your existing CLI installations and local authentication.
# No CLI is installed, logged in, or invoked automatically in demo mode.
