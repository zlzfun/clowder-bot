+import type { IThreadStore } from '../../stores/ports/ThreadStore.js';
+
+/** Optional deployment policy. Native Clowder AI behavior is unchanged when disabled.
+ * In a Bot-owned deployment, persisted preferredCats is the execution roster.
+ * This constrains execution, not memory visibility or filesystem permissions.
+ */
+export async function assertThreadParticipant(
+  threadStore: Pick<IThreadStore, 'get'> | null,
+  threadId: string,
+  catId: string,
+  enabled = process.env.CAT_CAFE_ENFORCE_THREAD_PARTICIPANTS === '1',
+): Promise<void> {
+  if (!enabled) return;
+  const thread = await threadStore?.get(threadId);
+  if (!thread?.preferredCats?.includes(catId as never)) {
+    throw new Error(`Member ${catId} is not in the execution roster of thread ${threadId}`);
+  }
+}
