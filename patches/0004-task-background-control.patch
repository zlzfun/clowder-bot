+      }
+    }
+  }
+
+  async stopRef(ref: Execution, userId: string, messageRef?: string) {
+    const task = await this.byRef(ref, userId);
+    if (!task?.backgroundExecution) throw new TaskBackgroundError('background_task_binding_required');
+    await this.control(
+      task.id,
+      userId,
+      {
+        action: 'stop',
+        expectedOwnerRevision: task.ownerRevision ?? 0,
+        expectedAttemptId: task.backgroundExecution.attemptId,
+      },
+      undefined,
+      true,
+      messageRef,
+    );
+  }
+
+  async mutationFence(task: TaskItem) {
+    const ancestors = await this.ancestors(task);
+    return {
+      watchKeys: [
+        ...ancestors.map((parent) => TaskKeys.detail(parent.id)),
+        ...[task, ...ancestors].flatMap((t) => this.sourceKeys(t).map((id) => `msg:${id}`)),
+      ],
+      assertCurrent: () => this.assertAdmitted(task),
+    };
+  }
+
+  private async reconcileTask(task: TaskItem) {
+    const bg = task.backgroundExecution;
+    if (!bg || backgroundTerminal(task) || this.hosts.has(bg.invocationId)) return;
+    const proven =
+      task.executionRef && task.userId && (await this.deps.executionIsStopped?.(task.executionRef, task.userId));
