diff --git a/packages/api/src/domains/cats/services/background/TaskBackgroundRuntime.ts b/packages/api/src/domains/cats/services/background/TaskBackgroundRuntime.ts
new file mode 100644
index 00000000..c85cc8cc
--- /dev/null
+++ b/packages/api/src/domains/cats/services/background/TaskBackgroundRuntime.ts
@@ -0,0 +1,737 @@
+import type { IMessageStore } from '../stores/ports/MessageStore.js';
+import { assertThreadParticipant } from '../agents/invocation/thread-participant-policy.js';
+import type { IThreadStore } from '../stores/ports/ThreadStore.js';
+import { ThreadKeys } from '../stores/redis-keys/thread-keys.js';
+import { createModuleLogger } from '../../../../infrastructure/logger.js';
+import { randomUUID } from 'node:crypto';
+import type { TaskItem } from '@cat-cafe/shared';
+import {
+  backgroundTerminal,
+  ordinaryTaskExpectation,
+  sameTaskExecution,
+  type TaskMutationActor,
+} from '../stores/ports/OrdinaryTaskMutation.js';
+import type { ITaskStore } from '../stores/ports/TaskStore.js';
+import type { TaskMutationWriteFence } from '../stores/ports/TaskStoreContract.js';
+import { isOrdinaryImplementTask } from '../stores/ports/TaskStoreContract.js';
+import { TaskKeys } from '../stores/redis-keys/task-keys.js';
+
+const log = createModuleLogger('task-background');
+type Execution = NonNullable<TaskItem['executionRef']>;
+type Background = NonNullable<TaskItem['backgroundExecution']>;
+export type BackgroundScope = TaskMutationActor & { parentInvocationId: string };
+type LiveHost = {
+  scope: BackgroundScope;
+  stop(taskId: string): Promise<void>;
+  tools: Map<string, string>;
+  sdkAttempts: Map<string, string>;
+  closed: boolean;
+};
+
+export class TaskBackgroundError extends Error {
+  constructor(readonly code: string) {
+    super(code);
+  }
+}
+
+/** Native Task is the durable authority. This map contains only live SDK control handles. */
+export class TaskBackgroundRuntime {
+  private readonly hosts = new Map<string, LiveHost>();
+  constructor(
+    readonly deps: {
+      tasks: ITaskStore;
+      executionIsStopped?(ref: Execution, userId: string): Promise<boolean>;
+      stopExecution?(ref: Execution, userId: string): Promise<void>;
+      messages?: Pick<IMessageStore, 'getById'>;
+      threads?: Pick<IThreadStore, 'get'>;
+      changed?(task: TaskItem): void;
+      released?(threadId: string): void;
+    },
+  ) {}
+
+  attach(scope: BackgroundScope, stop: (taskId: string) => Promise<void>) {
+    if (this.hosts.has(scope.invocationId)) throw new TaskBackgroundError('background_host_already_attached');
+    const host: LiveHost = { scope, stop, tools: new Map(), sdkAttempts: new Map(), closed: false };
+    this.hosts.set(scope.invocationId, host);
+    return {
+      reserve: (taskId: string, toolUseId: string, sessionId: string) =>
+        this.reserve(host, taskId, toolUseId, sessionId),
+      observe: async (raw: Record<string, unknown>) => {
+        try {
+          await this.observe(host, raw);
+        } catch (err) {
+          log.warn({ err, invocationId: scope.invocationId }, 'Task observation failed; parent query remains active');
+          try {
+            const taskId = host.tools.get(String(raw.tool_use_id));
+            const task = taskId
+              ? await this.deps.tasks.get(taskId)
+              : (await this.deps.tasks.listByThread(scope.threadId)).find(
+                  (t) => t.backgroundExecution?.sdkTaskId === raw.task_id,
+                );
+            const bg = task?.backgroundExecution;
+            if (
+              task &&
+              bg?.invocationId === scope.invocationId &&
+              bg.sessionId === raw.session_id &&
+              (bg.toolUseId === raw.tool_use_id || bg.sdkTaskId === raw.task_id)
+            )
+              await this.observeAttempt(task.id, bg.attemptId, { state: 'unknown' });
+          } catch (recoveryError) {
+            log.warn({ err: recoveryError }, 'Task observation uncertainty could not be persisted');
+          }
+        }
+      },
+      canMessage: async (target: unknown) => {
+        if (typeof target !== 'string' || host.closed) return false;
+        return (await this.deps.tasks.listByThread(scope.threadId)).some(
+          (task) =>
+            task.userId === scope.userId &&
+            task.ownerCatId === scope.catId &&
+            task.backgroundExecution?.invocationId === scope.invocationId &&
+            task.backgroundExecution.sdkTaskId === target &&
+            task.executionRef?.subexecutionId === task.backgroundExecution.attemptId &&
+            !backgroundTerminal(task) &&
+            !task.backgroundStopRequestedAt &&
+            !task.backgroundCancelledAt,
+        );
+      },
+      launchFailed: async (toolUseId: string, sessionId: string, interrupted = false) => {
+        const id = host.tools.get(toolUseId);
+        const task = id ? await this.deps.tasks.get(id) : null;
+        const bg = task?.backgroundExecution;
+        if (task && bg && bg.sessionId === sessionId && bg.invocationId === scope.invocationId && !bg.sdkTaskId)
+          await this.observeAttempt(task.id, bg.attemptId, {
+            state: interrupted ? 'unknown' : 'failed',
+            ...(interrupted ? {} : { endedAt: Date.now() }),
+            summary: interrupted
+              ? 'Agent launch interrupted; awaiting exact child receipt'
+              : 'Agent tool launch failed before a child was started',
+          }).then(async () => {
+            await this.cleanupAbortedHandoffs(scope.threadId);
+            this.deps.released?.(scope.threadId);
+          });
+      },
+      close: () => this.close(host),
+    };
+  }
+
+  ownsInvocation(invocationId: string) {
+    return this.hosts.has(invocationId);
+  }
+
+  private async ancestors(task: TaskItem): Promise<TaskItem[]> {
+    const result: TaskItem[] = [];
+    const seen = new Set([task.id]);
+    let parentId = task.delegatedFromTaskId;
+    while (parentId) {
+      if (seen.has(parentId) || result.length >= 10) throw new TaskBackgroundError('task_delegation_cycle_or_depth');
+      seen.add(parentId);
+      const parent = await this.deps.tasks.get(parentId);
+      if (!parent || parent.userId !== task.userId || parent.threadId !== task.threadId)
+        throw new TaskBackgroundError('task_delegation_authority_changed');
+      result.push(parent);
+      parentId = parent.delegatedFromTaskId;
+    }
+    return result;
+  }
+
+  private async assertAdmitted(task: TaskItem) {
+    if (task.backgroundCancelledAt || task.backgroundStopRequestedAt || task.status === 'done')
+      throw new TaskBackgroundError('task_not_open');
+    await this.assertSource(task);
+    for (const parent of await this.ancestors(task)) {
+      await this.assertSource(parent);
+      if (parent.backgroundCancelledAt || parent.backgroundStopRequestedAt || parent.status === 'done')
+        throw new TaskBackgroundError('task_ancestor_not_open');
+    }
+  }
+
+  private sourceKeys(task: TaskItem) {
+    return [
+      ...new Set(
+        [task.executionRef?.sourceMessageId, task.lastAppliedHandoffMessageRef?.slice('message:'.length)].filter(
+          (id): id is string => !!id,
+        ),
+      ),
+    ];
+  }
+
+  private async assertSource(task: TaskItem) {
+    if (!this.deps.messages) return;
+    for (const id of this.sourceKeys(task)) {
+      const message = await this.deps.messages.getById(id);
+      if (!message || message.deletedAt || message.recall || message._tombstone || message.extra?.taskHandoffInvalid)
+        throw new TaskBackgroundError('task_source_withdrawn');
+    }
+  }
+
+  private async reserve(host: LiveHost, taskId: string, toolUseId: string, sessionId: string) {
+    if (host.closed || !toolUseId || !sessionId) throw new TaskBackgroundError('background_host_closed');
+    const task = await this.deps.tasks.get(taskId);
+    const scope = host.scope;
+    if (
+      !task ||
+      !isOrdinaryImplementTask(task) ||
+      task.userId !== scope.userId ||
+      task.threadId !== scope.threadId ||
+      task.ownerCatId !== scope.catId
+    )
+      throw new TaskBackgroundError('background_task_owner_required');
+    if (host.tools.size >= 128) throw new TaskBackgroundError('background_host_task_limit');
+    if (host.tools.has(toolUseId)) throw new TaskBackgroundError('background_launch_already_reserved');
+    await assertThreadParticipant(this.deps.threads ?? null, scope.threadId, scope.catId);
+    await this.assertAdmitted(task);
+    const ancestors = await this.ancestors(task);
+    const attemptId = randomUUID();
+    const now = Date.now();
+    const result = await this.deps.tasks.mutateOrdinaryTask(
+      {
+        kind: 'background_reserve',
+        taskId,
+        expected: ordinaryTaskExpectation(task),
+        actor: scope,
+        execution: {
+          invocationId: scope.invocationId,
+          parentInvocationId: scope.parentInvocationId,
+          catId: scope.catId,
+          threadId: scope.threadId,
+          sourceMessageId: task.executionRef?.sourceMessageId ?? task.sourceMessageId ?? null,
+          subexecutionId: attemptId,
+        },
+        background: {
+          ownerRevision: task.ownerRevision ?? 0,
+          attemptId,
+          invocationId: scope.invocationId,
+          parentInvocationId: scope.parentInvocationId,
+          toolUseId,
+          sessionId,
+          state: 'starting',
+          startedAt: now,
+          updatedAt: now,
+        },
+      },
+      {
+        watchKeys: [
+          ThreadKeys.detail(scope.threadId),
+          ...ancestors.map((parent) => TaskKeys.detail(parent.id)),
+          ...[task, ...ancestors].flatMap((t) => this.sourceKeys(t).map((id) => `msg:${id}`)),
+        ],
+        assertCurrent: async () => {
+          if (host.closed) throw new TaskBackgroundError('background_host_closed');
+          await assertThreadParticipant(this.deps.threads ?? null, scope.threadId, scope.catId);
+          await this.assertAdmitted(task);
+        },
+      },
+    );
+    if (result.kind !== 'updated') throw new TaskBackgroundError('background_task_assignment_changed');
+    host.tools.set(toolUseId, taskId);
+    this.deps.changed?.(result.task);
+    return result.task;
+  }
+
+  private async observe(host: LiveHost, raw: Record<string, unknown>) {
+    if (host.closed || raw.type !== 'system' || !['task_started', 'task_notification'].includes(String(raw.subtype)))
+      return;
+    const sdkTaskId = typeof raw.task_id === 'string' ? raw.task_id : undefined;
+    const sessionId = typeof raw.session_id === 'string' ? raw.session_id : undefined;
+    if (!sdkTaskId || !sessionId) return;
+    const candidates = await this.deps.tasks.listByThread(host.scope.threadId);
+    const task = candidates.find(
+      (t) =>
+        t.userId === host.scope.userId &&
+        t.ownerCatId === host.scope.catId &&
+        (t.backgroundExecution?.invocationId === host.scope.invocationId ||
+          (raw.subtype === 'task_notification' && raw.status === 'stopped' && raw.reason === 'worker_restart')) &&
+        t.backgroundExecution?.sessionId === sessionId &&
+        (raw.subtype === 'task_started'
+          ? t.backgroundExecution.toolUseId === raw.tool_use_id && host.tools.get(String(raw.tool_use_id)) === t.id
+          : t.backgroundExecution.sdkTaskId === sdkTaskId ||
+            (!t.backgroundExecution.sdkTaskId &&
+              t.backgroundExecution.toolUseId === raw.tool_use_id &&
+              host.tools.get(String(raw.tool_use_id)) === t.id)),
+    );
+    if (!task?.backgroundExecution || !task.executionRef?.subexecutionId) return;
+    const bg = task.backgroundExecution;
+    if (backgroundTerminal(task)) return;
+    let patch: Partial<Background>;
+    if (raw.subtype === 'task_started') {
+      if (host.sdkAttempts.has(sdkTaskId) && host.sdkAttempts.get(sdkTaskId) !== bg.attemptId)
+        throw new TaskBackgroundError('background_resumed_child_requires_new_identity');
+      host.sdkAttempts.set(sdkTaskId, bg.attemptId);
+      if (bg.sdkTaskId && bg.sdkTaskId !== sdkTaskId)
+        throw new TaskBackgroundError('background_child_identity_changed');
+      patch = { sdkTaskId, state: bg.stopRequestedAt ? 'stopping' : 'running' };
+    } else {
+      if (typeof raw.tool_use_id === 'string' && raw.tool_use_id !== bg.toolUseId) return;
