+          log.warn({ err, taskId: task.id }, 'Could not record lost Task host'),
+        );
+    }
+  }
+
+  async control(
+    taskId: string,
+    userId: string,
+    input: { action: 'stop' | 'cancel' | 'resume'; expectedOwnerRevision: number; expectedAttemptId: string | null },
+    fence?: TaskMutationWriteFence,
+    handoff = false,
+    handoffMessageRef?: string,
+  ) {
+    const found = await this.deps.tasks.get(taskId);
+    if (found?.userId === userId) await this.reconcileTask(found);
+    const task = await this.deps.tasks.get(taskId);
+    if (!task || task.userId !== userId) throw new TaskBackgroundError('task_not_found');
+    if (
+      (task.ownerRevision ?? 0) !== input.expectedOwnerRevision ||
+      (task.backgroundExecution?.attemptId ?? null) !== input.expectedAttemptId
+    )
+      throw new TaskBackgroundError('task_assignment_changed');
+    if (input.action === 'resume' && !(await this.descendantsStopped(task)))
+      throw new TaskBackgroundError('task_descendant_stop_unproven');
+    if (input.action === 'resume' && task.executionRef && !task.executionRef.subexecutionId) {
+      if (!(await this.deps.executionIsStopped?.(task.executionRef, userId)))
+        throw new TaskBackgroundError('task_execution_stop_unproven');
+    }
+    const result = await this.deps.tasks.mutateOrdinaryTask(
+      {
+        kind: 'background_control',
+        taskId,
+        expected: ordinaryTaskExpectation(task),
+        userId,
+        action: input.action,
+        handoff,
+        handoffMessageRef,
+        expectedAttemptId: input.expectedAttemptId,
+      },
+      fence,
+    );
+    if (result.kind !== 'updated' && result.kind !== 'replayed')
+      throw new TaskBackgroundError('background_control_unavailable');
+    this.deps.changed?.(result.task);
+    const descendants = await this.descendants(task);
+    const failures: string[] = [];
+    const stopScope = new Set([taskId, ...descendants.map((t) => t.id)]);
