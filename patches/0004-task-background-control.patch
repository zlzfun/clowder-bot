+        if (current.backgroundExecution && !backgroundTerminal(current)) continue;
+        if (!current.backgroundExecution && current.executionRef) continue;
+        const resumed = await this.deps.tasks.mutateOrdinaryTask({
+          kind: 'background_control',
+          taskId: current.id,
+          expected: ordinaryTaskExpectation(current),
+          userId,
+          action: 'resume',
+          originTaskId: taskId,
+          expectedAttemptId: current.backgroundExecution?.attemptId ?? null,
+        });
+        if (resumed.kind === 'updated') this.deps.changed?.(resumed.task);
+      }
+    }
+    return { task: (await this.deps.tasks.get(taskId))!, requested: true, unconfirmedTaskIds: failures };
+  }
+
+  private async stopCurrent(task: TaskItem, stopScope = new Set([task.id])) {
+    const bg = task.backgroundExecution;
+    if (!bg || task.executionRef?.subexecutionId !== bg.attemptId) {
+      if (!task.executionRef) return;
+      const ref = task.executionRef;
+      const outsiders = (await this.deps.tasks.listByKind('work')).some(
+        (other) =>
+          other.userId === task.userId &&
+          !stopScope.has(other.id) &&
+          other.executionRef?.invocationId === ref.invocationId &&
+          other.executionRef.parentInvocationId === ref.parentInvocationId &&
+          (other.status !== 'done' || (other.backgroundExecution && !backgroundTerminal(other))),
+      );
+      if (outsiders || this.ownsInvocation(task.executionRef.invocationId))
+        throw new TaskBackgroundError('background_task_binding_required');
+      await this.deps.stopExecution?.(task.executionRef, task.userId!);
+      if (!(await this.deps.executionIsStopped?.(task.executionRef, task.userId!)))
+        throw new TaskBackgroundError('task_execution_stop_unproven');
+      return;
+    }
+    if (backgroundTerminal(task)) return;
+    const host = this.hosts.get(bg.invocationId);
+    if (!host || host.closed || host.scope.userId !== task.userId) {
+      await this.observeAttempt(task.id, bg.attemptId, { state: 'unknown' });
+      throw new TaskBackgroundError('background_host_unavailable');
+    }
+    if (bg.sdkTaskId) {
+      try {
+        await host.stop(bg.sdkTaskId);
+      } catch (err) {
+        await this.observeAttempt(task.id, bg.attemptId, { state: 'unknown' });
+        throw err;
+      }
+    }
+    // A starting child is stopped when its exact task_started receipt arrives.
+  }
+
+  private async byRef(ref: Execution, userId: string) {
+    return (await this.deps.tasks.listByThread(ref.threadId)).find(
+      (task) => task.userId === userId && sameTaskExecution(task.executionRef, ref),
+    );
+  }
+
+  private async descendants(task: TaskItem): Promise<TaskItem[]> {
+    const all = await this.deps.tasks.listByThread(task.threadId);
+    const seen = new Set([task.id]),
+      result: TaskItem[] = [];
+    for (let i = 0, pending = [task.id]; i < pending.length; i++) {
+      for (const child of all) {
+        if (child.userId !== task.userId || child.delegatedFromTaskId !== pending[i] || seen.has(child.id)) continue;
+        seen.add(child.id);
+        result.push(child);
+        pending.push(child.id);
+      }
+    }
+    return result;
+  }
+
+  async isStopped(ref: Execution, userId: string): Promise<boolean> {
+    if (!ref.subexecutionId) return false;
+    let task = await this.byRef(ref, userId);
+    if (!task) return false;
+    await this.reconcileTask(task);
+    task = await this.byRef(ref, userId);
+    if (!task || task.backgroundExecution?.attemptId !== ref.subexecutionId || !backgroundTerminal(task)) return false;
+    return this.descendantsStopped(task);
+  }
+
+  private async descendantsStopped(task: TaskItem): Promise<boolean> {
+    for (const child of await this.descendants(task)) {
+      await this.reconcileTask(child);
+      const current = (await this.deps.tasks.get(child.id))!;
+      if (current.backgroundExecution && !backgroundTerminal(current)) return false;
+      if (
+        current.executionRef &&
+        !current.executionRef.subexecutionId &&
+        !(await this.deps.executionIsStopped?.(current.executionRef, task.userId!))
+      )
+        return false;
+    }
+    return true;
+  }
+
+  /** A coordinator Task can have no own execution while delegated descendants are still live. */
+  async handoffBarrier(task: TaskItem, stopPrevious: boolean, messageRef?: string): Promise<Execution | undefined> {
+    if (!(await this.descendants(task)).length) return;
+    if (stopPrevious)
+      await this.control(
+        task.id,
+        task.userId!,
+        {
+          action: 'stop',
+          expectedOwnerRevision: task.ownerRevision ?? 0,
+          expectedAttemptId: task.backgroundExecution?.attemptId ?? null,
+        },
+        undefined,
+        true,
+        messageRef,
+      );
+    for (const child of await this.descendants(task)) {
+      await this.reconcileTask(child);
+      const current = (await this.deps.tasks.get(child.id))!;
+      if (!current.executionRef) continue;
+      if (
+        current.executionRef.subexecutionId
+          ? !backgroundTerminal(current)
+          : !(await this.deps.executionIsStopped?.(current.executionRef, task.userId!))
+      )
+        return current.executionRef;
+    }
+  }
+
+  async sharesInvocation(ref: Execution) {
+    if (this.ownsInvocation(ref.invocationId)) return true;
+    return (
+      (await this.deps.tasks.listByKind('work')).filter(
+        (task) =>
+          task.executionRef?.invocationId === ref.invocationId &&
+          task.executionRef.parentInvocationId === ref.parentInvocationId &&
+          (task.status !== 'done' || (task.backgroundExecution && !backgroundTerminal(task))),
+      ).length > 1
+    );
+  }
+
+  async completeHandoff(task: TaskItem) {
+    for (const child of await this.descendants(task)) {
+      if (
+        (child.backgroundHandoffMessageRef &&
+          child.backgroundHandoffMessageRef !== task.lastAppliedHandoffMessageRef) ||
+        child.backgroundStopReason !== 'handoff' ||
+        child.backgroundStopOwnerTaskId !== task.id ||
+        child.backgroundCancelledAt
+      )
+        continue;
+      if (child.backgroundExecution && !backgroundTerminal(child)) continue;
+      if (
+        child.executionRef &&
+        !child.executionRef.subexecutionId &&
+        !(await this.deps.executionIsStopped?.(child.executionRef, task.userId!))
+      )
+        continue;
+      const result = await this.deps.tasks.mutateOrdinaryTask({
+        kind: 'background_control',
+        taskId: child.id,
+        expected: ordinaryTaskExpectation(child),
+        userId: task.userId!,
+        action: 'resume',
+        handoff: true,
+        handoffMessageRef: child.backgroundHandoffMessageRef,
+        originTaskId: task.id,
+        expectedAttemptId: child.backgroundExecution?.attemptId ?? null,
+      });
+      if (result.kind === 'updated') this.deps.changed?.(result.task);
+    }
+  }
+
+  /** Durable recovery stays on native Task records and existing receipt/read paths. */
+  async abortHandoff(sourceMessageId: string) {
+    const messageRef = `message:${sourceMessageId}`;
+    const threads = new Set<string>();
+    for (const task of await this.deps.tasks.listByKind('work')) {
+      if (task.backgroundStopReason !== 'handoff' || task.backgroundHandoffMessageRef !== messageRef || !task.userId)
+        continue;
+      const result = await this.deps.tasks.mutateOrdinaryTask({
+        kind: 'background_handoff_abort',
+        taskId: task.id,
+        expected: ordinaryTaskExpectation(task),
+        userId: task.userId,
+        messageRef,
+      });
+      if (result.kind === 'updated') this.deps.changed?.(result.task);
+      threads.add(task.threadId);
+    }
+    for (const threadId of threads) await this.cleanupAbortedHandoffs(threadId);
+  }
+
+  private async cleanupAbortedHandoffs(threadId: string) {
+    const pending = (await this.deps.tasks.listByThread(threadId)).filter(
+      (t) => t.backgroundHandoffAbortedAt && t.backgroundHandoffMessageRef,
+    );
+    const handled = new Set<string>();
+    for (const pendingTask of pending) {
+      const origin = pendingTask.backgroundStopOwnerTaskId;
+      const messageRef = pendingTask.backgroundHandoffMessageRef!;
+      const key = `${origin}:${messageRef}`;
+      if (!origin || handled.has(key)) continue;
+      handled.add(key);
+      const root = await this.deps.tasks.get(origin);
+      if (!root || root.userId !== pendingTask.userId || root.threadId !== threadId) continue;
+      const tree = [...(await this.descendants(root)), root];
