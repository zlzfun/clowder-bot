diff --git a/packages/api/src/domains/cats/services/agents/providers/claude-sdk-native-mcp.ts b/packages/api/src/domains/cats/services/agents/providers/claude-sdk-native-mcp.ts
new file mode 100644
index 00000000..3999da66
--- /dev/null
+++ b/packages/api/src/domains/cats/services/agents/providers/claude-sdk-native-mcp.ts
@@ -0,0 +1,112 @@
+import type { McpSdkServerConfigWithInstance } from '@anthropic-ai/claude-agent-sdk';
+import { Client } from '@modelcontextprotocol/sdk/client/index.js';
+import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';
+import { StreamableHTTPClientTransport } from '@modelcontextprotocol/sdk/client/streamableHttp.js';
+import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
+import { CallToolRequestSchema, ListToolsRequestSchema } from '@modelcontextprotocol/sdk/types.js';
+
+/** Match the CLI's long MCP tool budget; both sides receive the same explicit limit. */
+export function nativeMcpTimeout(config: Record<string, unknown>, env = process.env) {
+  const timeout = Number(config.timeout ?? env.MCP_TOOL_TIMEOUT ?? 100_000_000);
+  return Number.isSafeInteger(timeout) && timeout >= 1000 && timeout <= 2_147_483_647 ? timeout : 100_000_000;
+}
+
+/** Native plugin aliases may carry callback authority without a cat-cafe name. */
+export function carriesNativeMcpAuthority(name: string, config: Record<string, unknown>) {
+  return (
+    /cat[_-]cafe/i.test(name) ||
+    [config.env, config.headers].some(
+      (value) =>
+        value &&
+        typeof value === 'object' &&
+        Object.entries(value).some(
+          ([key, v]) =>
+            !!v &&
+            /(?:CAT_CAFE_(?:CALLBACK_TOKEN|CREDENTIAL_FILE|NATIVE_TURN_CREDENTIAL_FILE)|CLOWDER_PLUGIN_ACTION_TOKEN|x-callback-token|x-clowder-plugin-action-token)/i.test(
+              key,
+            ),
+        ),
+    )
+  );
+}
+
+/** Keep callback transports in the API host, outside model CLI environment/config. */
+export function hostNativeMcp(servers: Record<string, Record<string, unknown>>) {
+  const sdk: Record<string, McpSdkServerConfigWithInstance> = {};
+  const external: typeof servers = {};
+  const connections = new Set<Client>();
+  let closed = false;
+  for (const [name, config] of Object.entries(servers)) {
+    if (!carriesNativeMcpAuthority(name, config)) {
+      external[name] = config;
+      continue;
+    }
+    const server = new McpServer({ name, version: '1.0.0' }, { capabilities: { tools: {} } });
+    const timeout = nativeMcpTimeout(config);
+    let clientPromise: Promise<Client> | undefined;
+    const client = () => {
+      if (closed) return Promise.reject(new Error('native_sdk_mcp_closed'));
+      if (clientPromise) return clientPromise;
+      const connection = new Client({ name: 'native-sdk-host', version: '1.0.0' });
+      connections.add(connection);
+      const pending = (async () => {
+        if (typeof config.command === 'string') {
+          await connection.connect(
+            new StdioClientTransport({
+              command: config.command,
+              args: config.args as string[] | undefined,
+              env: config.env as Record<string, string> | undefined,
+              ...(typeof config.cwd === 'string' ? { cwd: config.cwd } : {}),
+              stderr: 'ignore',
+            }),
+          );
+        } else if (config.type === 'http' && typeof config.url === 'string') {
+          await connection.connect(
+            new StreamableHTTPClientTransport(new URL(config.url), {
+              requestInit: { headers: config.headers as Record<string, string> | undefined },
+            }),
+          );
+        } else throw new Error('native_sdk_mcp_transport_unsupported');
+        return connection;
+      })();
+      clientPromise = pending;
+      connection.onclose = () => {
+        connections.delete(connection);
+        if (clientPromise === pending) clientPromise = undefined;
+      };
+      void pending.catch(async () => {
+        if (clientPromise === pending) clientPromise = undefined;
+        connections.delete(connection);
+        await connection.close().catch(() => {});
+      });
+      return pending;
+    };
+    server.server.setRequestHandler(ListToolsRequestSchema, async (request, extra) =>
+      (await client()).listTools(request.params, { signal: extra.signal }),
+    );
+    server.server.setRequestHandler(CallToolRequestSchema, async (request, extra) =>
+      (await client()).callTool(request.params, undefined, {
+        signal: extra.signal,
+        timeout,
+        maxTotalTimeout: timeout,
+        resetTimeoutOnProgress: true,
+        onprogress: (progress) => {
+          const progressToken = request.params._meta?.progressToken;
+          if (progressToken !== undefined)
+            void extra
+              .sendNotification({ method: 'notifications/progress', params: { ...progress, progressToken } })
+              .catch(() => {});
+        },
+      }),
+    );
+    sdk[name] = { type: 'sdk', name, instance: server, timeout };
+  }
+  return {
+    sdk,
+    external,
+    close: async () => {
+      closed = true;
+      await Promise.allSettled([...connections].map((client) => client.close()));
+    },
+  };
+}
diff --git a/packages/api/src/domains/cats/services/agents/providers/claude-sdk-task-hooks.ts b/packages/api/src/domains/cats/services/agents/providers/claude-sdk-task-hooks.ts
new file mode 100644
index 00000000..4e0749fe
--- /dev/null
+++ b/packages/api/src/domains/cats/services/agents/providers/claude-sdk-task-hooks.ts
@@ -0,0 +1,78 @@
+import type { HookCallbackMatcher, HookEvent, HookJSONOutput } from '@anthropic-ai/claude-agent-sdk';
+import type { TaskBackgroundRuntime } from '../../background/TaskBackgroundRuntime.js';
+
+type Lane = ReturnType<TaskBackgroundRuntime['attach']>;
+
+/** The description is an assignment request, not authority: reserve rechecks the native Task CAS. */
+export function sdkTaskHooks(lane: Lane, canStop: () => boolean): Partial<Record<HookEvent, HookCallbackMatcher[]>> {
+  const deny = (reason: string): HookJSONOutput => ({
+    hookSpecificOutput: { hookEventName: 'PreToolUse', permissionDecision: 'deny', permissionDecisionReason: reason },
+  });
+  const pre: HookCallbackMatcher['hooks'][number] = async (input) => {
+    if (input.hook_event_name !== 'PreToolUse') return {};
+    const value = input.tool_input as Record<string, unknown> | null;
+    if (input.tool_name === 'SendMessage') {
+      let admitted = false;
+      try {
+        admitted = await lane.canMessage(value?.to ?? value?.recipient);
+      } catch {
+        return deny('Task identity unavailable; message not admitted.');
+      }
+      if (input.agent_id || (value?.type !== undefined && value.type !== 'message') || !admitted)
+        return deny(
+          '仅可向当前 invocation 中仍在执行、未停止的精确 Task 子执行投递；已结束 Agent 必须新建受管 attempt。',
+        );
+      return {};
+    }
+    if (input.tool_name === 'TaskStop')
+      return deny('请通过原生 Task 控制停止或新建受管子任务；不可直接停止兄弟任务或恢复旧 SDK Agent。');
+    if (input.agent_id) {
+      // Native MCP remains in the API host; child tool hooks deny access to parent authority.
+      if (
+        /cat[_-]cafe/i.test(input.tool_name) ||
+        input.mcp_server?.source === 'sdk' ||
+        ['Agent', 'Task', 'Workflow', 'CronCreate', 'ScheduleWakeup'].includes(input.tool_name)
+      )
+        return deny('后台执行只能完成已分配工作；Task 状态、传球和继续委派请返回主 Agent 处理。');
+      if (value?.run_in_background === true) return deny('任务内命令须前台等待完成，不能留下未绑定的后台工作。');
+      return {};
+    }
+    if (value?.run_in_background === true && !['Agent', 'Task'].includes(input.tool_name))
+      return deny('Background work requires a bound native Task Agent.');
+    if (input.tool_name === 'Workflow')
+      return deny('Use native Task-backed delegation; Workflow is not a bound execution.');
+    if (!['Agent', 'Task'].includes(input.tool_name)) return {};
+    if (value?.resume || value?.team_name || value?.isolation === 'remote')
+      return deny('受管 Task 只允许新建本地后台 Agent，不能恢复旧 Agent、创建 team 或使用 remote isolation。');
+    if (!canStop()) return deny('当前 provider 未提供精确子任务停止能力，不能启动受管后台任务。');
+    if (value?.run_in_background !== true) return deny('持续工作必须使用 run_in_background=true，保持主会话响应。');
+    const taskId =
+      typeof value.description === 'string'
+        ? /^\[task:([A-Za-z0-9_-]{1,128})\](?:\s|$)/.exec(value.description)?.[1]
+        : undefined;
+    if (!taskId)
+      return deny(
+        '先创建并认领原生 Task（status=doing），再用 description="[task:原生TaskID] 工作说明" 启动后台 Agent。',
+      );
+    try {
+      await lane.reserve(taskId, input.tool_use_id, input.session_id);
+      return {};
+    } catch (error) {
+      return deny(error instanceof Error ? error.message : 'background_task_admission_failed');
+    }
+  };
+  return {
+    PreToolUse: [{ hooks: [pre] }],
+    PostToolUseFailure: [
+      {
+        hooks: [
+          async (input) => {
+            if (input.hook_event_name === 'PostToolUseFailure' && ['Agent', 'Task'].includes(input.tool_name))
+              await lane.launchFailed(input.tool_use_id, input.session_id, input.is_interrupt === true);
+            return {};
+          },
+        ],
+      },
+    ],
+  };
+}
