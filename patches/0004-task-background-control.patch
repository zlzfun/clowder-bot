diff --git a/packages/api/src/routes/task-background-routes.ts b/packages/api/src/routes/task-background-routes.ts
new file mode 100644
index 00000000..a34e481f
--- /dev/null
+++ b/packages/api/src/routes/task-background-routes.ts
@@ -0,0 +1,31 @@
+import type { FastifyInstance } from 'fastify';
+import { z } from 'zod';
+import {
+  TaskBackgroundError,
+  type TaskBackgroundRuntime,
+} from '../domains/cats/services/background/TaskBackgroundRuntime.js';
+import { resolveSessionUserId } from '../utils/request-identity.js';
+
+const control = z
+  .object({
+    action: z.enum(['stop', 'cancel', 'resume']),
+    expectedOwnerRevision: z.number().int().nonnegative(),
+    expectedAttemptId: z.string().min(1).max(128).nullable(),
+  })
+  .strict();
+
+export function registerTaskBackgroundRoutes(app: FastifyInstance, runtime: TaskBackgroundRuntime) {
+  app.post<{ Params: { id: string } }>('/api/tasks/:id/background-control', async (request, reply) => {
+    const userId = resolveSessionUserId(request);
+    if (!userId) return reply.code(401).send({ error: 'Identity required' });
+    const input = control.safeParse(request.body);
+    if (!input.success) return reply.code(400).send({ error: 'Invalid background control request' });
+    try {
+      return await runtime.control(request.params.id, userId, input.data);
+    } catch (error) {
+      if (error instanceof TaskBackgroundError)
+        return reply.code(error.code === 'task_not_found' ? 404 : 409).send({ error: error.code });
+      throw error;
+    }
+  });
+}
