+          if (current.id !== taskId) {
+            const mutation = await this.deps.tasks.mutateOrdinaryTask({
+              kind: 'background_control',
+              taskId: current.id,
+              expected: ordinaryTaskExpectation(current),
+              userId,
+              action: 'stop',
+              originTaskId: taskId,
+              handoff,
+              handoffMessageRef,
+              expectedAttemptId: current.backgroundExecution?.attemptId ?? null,
+            });
+            if (mutation.kind !== 'updated' && mutation.kind !== 'replayed')
+              throw new TaskBackgroundError('descendant_execution_changed');
+            stopped = mutation.task;
+            this.deps.changed?.(stopped);
+          }
+          await this.stopCurrent(stopped, stopScope);
+        } catch (err) {
+          failures.push(current.id);
+          log.warn({ err, taskId: current.id }, 'Task stop intent persisted but delivery unproven');
