+    await this.observeAttempt(
+      task.id,
+      bg.attemptId,
+      proven
+        ? { state: 'stopped', endedAt: Date.now(), summary: 'Native exact provider teardown proved after host loss' }
+        : { state: 'unknown' },
+    );
+  }
+
+  async reconcileThread(threadId: string) {
+    for (const task of await this.deps.tasks.listByThread(threadId))
+      await this.reconcileTask(task).catch((err) =>
+        log.warn({ err, taskId: task.id }, 'Task recovery remains unproven'),
+      );
+    await this.cleanupAbortedHandoffs(threadId).catch((err) => log.warn({ err }, 'Handoff cleanup remains pending'));
+  }
+
+  async authorizeParentCreation(parentTaskId: string, actor: TaskMutationActor) {
+    const parent = await this.deps.tasks.get(parentTaskId);
+    if (
+      !parent ||
+      parent.userId !== actor.userId ||
+      parent.threadId !== actor.threadId ||
+      parent.ownerCatId !== actor.catId
+    )
+      throw new TaskBackgroundError('task_parent_authority_required');
+    await this.assertAdmitted(parent);
+    if ((await this.ancestors(parent)).length >= 9) throw new TaskBackgroundError('task_delegation_depth');
+    return parent;
+  }
+}
+
+let installed: TaskBackgroundRuntime | undefined;
+export function installTaskBackgroundRuntime(runtime: TaskBackgroundRuntime) {
+  installed = runtime;
+}
+export function taskBackgroundRuntime() {
+  return installed;
+}
