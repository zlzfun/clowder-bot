+          !current?.backgroundHandoffAbortedAt ||
+          current.backgroundStopReason !== 'handoff' ||
+          current.backgroundStopOwnerTaskId !== origin ||
+          current.backgroundHandoffMessageRef !== messageRef ||
+          current.backgroundCancelledAt
