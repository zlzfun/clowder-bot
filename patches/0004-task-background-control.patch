+        state: raw.status as Background['state'],
+        endedAt: Date.now(),
+        ...(typeof raw.summary === 'string' ? { summary: raw.summary.slice(0, 2000) } : {}),
+        ...(typeof raw.output_file === 'string' ? { resultRef: raw.output_file.slice(0, 2000) } : {}),
+      };
+    }
+    const changed = await this.observeAttempt(task.id, bg.attemptId, patch);
+    if (
+      changed?.backgroundExecution?.stopRequestedAt &&
+      !backgroundTerminal(changed) &&
+      changed.backgroundExecution.sdkTaskId
+    )
+      await this.stopCurrent(changed);
+    if (changed && backgroundTerminal(changed)) {
+      await this.cleanupAbortedHandoffs(changed.threadId).catch((err) => log.warn({ err }, 'Handoff cleanup pending'));
+      this.deps.released?.(changed.threadId);
+    }
+  }
+
+  private async observeAttempt(
+    taskId: string,
+    attemptId: string,
+    patch: Partial<Background>,
+  ): Promise<TaskItem | undefined> {
+    for (let retry = 0; retry < 3; retry++) {
+      const current = await this.deps.tasks.get(taskId);
+      if (
+        !current ||
+        current.backgroundExecution?.attemptId !== attemptId ||
+        current.executionRef?.subexecutionId !== attemptId
+      )
+        return;
+      // A concurrently requested stop may never be overwritten by a start event.
+      const effective =
+        patch.state === 'running' && current.backgroundExecution.stopRequestedAt
+          ? { ...patch, state: 'stopping' as const }
+          : patch;
+      const result = await this.deps.tasks.mutateOrdinaryTask({
+        kind: 'background_observe',
+        taskId,
+        expected: ordinaryTaskExpectation(current),
+        attemptId,
+        patch: effective,
+      });
+      if (result.kind === 'updated' || result.kind === 'replayed') {
+        if (result.kind === 'updated') this.deps.changed?.(result.task);
+        return result.task;
+      }
+    }
+    throw new TaskBackgroundError('background_observation_conflict');
+  }
+
+  private async close(host: LiveHost) {
+    if (host.closed) return;
+    host.closed = true;
+    this.hosts.delete(host.scope.invocationId);
+    // Stream closure / process loss alone is not proof that all task effects stopped.
+    for (const task of await this.deps.tasks.listByThread(host.scope.threadId)) {
