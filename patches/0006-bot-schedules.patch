+import type { DynamicTaskDef } from './DynamicTaskStore.js';
+
+/** Bot-owned one-shot history remains in the same native definition table, disabled. */
+export function retainBotReminderRecord(def: Pick<DynamicTaskDef, 'id' | 'templateId'> | null | undefined): boolean {
+  return process.env.CAT_CAFE_BOT_SCHEDULES === '1' && !!def && def.id.startsWith('dyn-bot-') && def.templateId === 'reminder';
+}
