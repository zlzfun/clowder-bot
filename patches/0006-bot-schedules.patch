@@ -0,0 +1,37 @@
+import { createHash } from 'node:crypto';
+import { isDeepStrictEqual } from 'node:util';
+import type { DynamicTaskStore } from '../infrastructure/scheduler/DynamicTaskStore.js';
+import type { ScheduleTaskSummary } from '../infrastructure/scheduler/types.js';
+import type { ScheduleMutationPrincipal } from './schedule-mutation-principal.js';
+
+export const botSchedulesEnabled = () => process.env.CAT_CAFE_BOT_SCHEDULES === '1';
+
+/** Expose only reminder attribution, never arbitrary template params or private authorization. */
+export function projectBotSchedules(tasks: ScheduleTaskSummary[], store?: DynamicTaskStore) {
+  if (!botSchedulesEnabled() || !store) return tasks;
+  return tasks.map(task => {
+    const def = store.getById(task.dynamicTaskId ?? task.id);
+    if (!def || def.templateId !== 'reminder' || !def.id.startsWith('dyn-')) return task;
+    return { ...task, templateId: def.templateId,
+      ...(typeof def.params.targetCatId === 'string' ? { targetCatId: def.params.targetCatId } : {}),
+      ...(typeof def.params.message === 'string' ? { prompt: def.params.message } : {}) };
+  });
+}
+
+/** Stable native identity uses the native SQLite definition and audit transaction; no extra store. */
+export function botScheduleRequestId(key: unknown, principal: ScheduleMutationPrincipal, templateId: string): string | null {
+  if (key === undefined) return null;
+  if (!botSchedulesEnabled() || principal.kind !== 'cvo' || templateId !== 'reminder') {
+    throw new Error('Bot schedule retry identity requires the configured owner and reminder template');
+  }
+  if (typeof key !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(key)) {
+    throw new Error('Invalid botIdempotencyKey');
+  }
+  return `dyn-bot-${createHash('sha256').update(principal.userId + ':' + key).digest('hex')}`;
+}
+
+type Definition = { templateId: string; trigger: unknown; params: unknown; display: unknown; deliveryThreadId: unknown };
+export function sameBotScheduleRequest(a: Definition, b: Definition): boolean {
+  return ['templateId', 'trigger', 'params', 'display', 'deliveryThreadId'].every(key =>
+    isDeepStrictEqual(a[key as keyof Definition], b[key as keyof Definition]));
+}
