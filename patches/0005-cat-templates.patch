--- /dev/null
+++ b/packages/api/src/config/bot-cat-templates.ts
@@ -0,0 +1,197 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { z } from 'zod';
+
+// Reusable creation defaults. Live members, execution and model discovery remain native.
+const choice = z.discriminatedUnion('mode', [
+  z.object({ mode: z.literal('inherit') }).strict(),
+  z.object({ mode: z.literal('explicit'), value: z.string().trim().min(1).max(512) }).strict(),
+]);
+export const botCatConfigSchema = z.object({
+  runtimeId: z.string().min(1).max(160).nullable(),
+  breed: z.discriminatedUnion('mode', [
+    z.object({ mode: z.literal('auto') }).strict(),
+    z.object({ mode: z.literal('explicit'), breedId: z.string().min(1).max(64) }).strict(),
+  ]),
+  model: choice,
+  effort: choice,
+  portrait: z.object({
+    roleDescription: z.string().max(32768), personality: z.string().max(32768).optional(),
+    teamStrengths: z.string().max(4096).optional(), strengths: z.array(z.string().max(200)).max(50).optional(),
+    caution: z.string().max(4096).nullable().optional(),
+  }).strict(),
+}).strict();
+export const botCatTemplateInputSchema = botCatConfigSchema.extend({
+  name: z.string().trim().min(1).max(64), nameHint: z.string().trim().max(64).default(''),
+});
+const revision = z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER - 1);
+export const botCatTemplateUpdateSchema = botCatTemplateInputSchema.extend({ expectedRevision: revision });
+export const botCatTemplateDeleteSchema = z.object({ expectedRevision: revision }).strict();
+const templateSchema = botCatTemplateInputSchema.extend({
+  id: z.string().min(1).max(160), revision,
+  source: z.object({ kind: z.enum(['native-seed', 'user']), breedId: z.string().optional(), variantId: z.string().optional() }).strict(),
+}).strict();
+export const botCatInstantiateSchema = z.object({
+  name: z.string().trim().min(1).max(64).regex(/^[\p{L}\p{N}_ .-]+$/u),
+  catConfig: botCatConfigSchema,
+  sourceTemplate: z.object({ id: z.string().min(1).max(160), revision }).strict().optional(),
+  idempotencyKey: z.string().uuid(),
+}).strict();
+export type BotCatConfig = z.infer<typeof botCatConfigSchema>;
+export type BotCatTemplate = z.infer<typeof templateSchema>;
+export type BotCatCreation = z.infer<typeof botCatInstantiateSchema>;
+export interface BotCatBreed { id: string; name: string; color: { primary: string; secondary: string } }
+const referenceSchema = z.object({ id: z.string(), revision, name: z.string() }).strict();
+const reservationSchema = z.object({
+  requestHash: z.string(), payload: z.record(z.string(), z.unknown()), sourceTemplate: referenceSchema.nullable(),
+}).strict();
+const stateSchema = z.object({
+  version: z.literal(1),
+  entries: z.record(z.string(), z.union([templateSchema, z.object({ deleted: z.literal(true), revision }).strict()])),
+  creations: z.record(z.string(), reservationSchema),
+}).strict();
+type State = z.infer<typeof stateSchema>;
+export class BotCatTemplateError extends Error {
+  constructor(readonly status: number, message: string) { super(message); }
+}
+const record = (value: unknown): Record<string, any> => value && typeof value === 'object' && !Array.isArray(value) ? value as Record<string, any> : {};
+const rows = (value: unknown): Record<string, any>[] => Array.isArray(value) ? value.map(record) : [];
+const str = (value: unknown, fallback = '') => typeof value === 'string' ? value : fallback;
+const selected = (value: unknown): BotCatConfig['model'] => str(value).trim() ? { mode: 'explicit', value: str(value).trim() } : { mode: 'inherit' };
+const canonical = (value: unknown): unknown => Array.isArray(value) ? value.map(canonical) : value && typeof value === 'object'
+  ? Object.fromEntries(Object.entries(value).sort(([a], [b]) => a.localeCompare(b)).map(([key, item]) => [key, canonical(item)])) : value;
+export const botCatRequestHash = (value: unknown) => createHash('sha256').update(JSON.stringify(canonical(value))).digest('hex');
+
+export function mergeBotCatTemplateSource(base: unknown, project: unknown) {
+  const shipped = record(base), local = record(project);
+  const overrides = rows(local.breeds), known = new Set(rows(shipped.breeds).map(b => b.id));
+  // Empty bootstrap member breeds do not erase the shipped creation menu.
+  // User template deletions live in this library's tombstones, not the member roster.
+  return { ...shipped, ...local,
+    breeds: [...rows(shipped.breeds).map(b => overrides.find(o => o.id === b.id) || b), ...overrides.filter(b => !known.has(b.id))],
+    roleTemplates: rows(local.roleTemplates).length ? local.roleTemplates : shipped.roleTemplates,
+  };
+}
+
+export function botCatTemplateSeeds(source: unknown): { templates: BotCatTemplate[]; breeds: BotCatBreed[] } {
+  const raw = record(source), nativeBreeds = rows(raw.breeds), roles = rows(raw.roleTemplates);
+  const identities = roles.length ? roles : nativeBreeds.filter(b => !b.relationshipKey || b.relationshipKey === b.id);
+  const templates: BotCatTemplate[] = [], breeds: BotCatBreed[] = [];
+  const seen = new Set<string>();
+  for (const role of identities) {
+    const id = role.id === 'turkish-van' ? 'moonshot' : str(role.relationshipKey || role.id);
+    if (!id || seen.has(id)) continue;
+    seen.add(id);
+    const breed = nativeBreeds.find(b => b.id === id) || {};
+    const variant = rows(breed.variants).find(v => v.id === breed.defaultVariantId) || rows(breed.variants)[0] || {};
+    const client = str(variant.clientId);
+    const runtimeId = ({ anthropic: 'claude', openai: 'codex', google: 'agy-native', kimi: 'kimi', opencode: 'opencode', antigravity: 'antigravity' } as Record<string, string>)[client] || null;
+    const color = record(role.color || breed.color);
+    const title = str(role.name, str(breed.displayName, id));
+    breeds.push({ id, name: title, color: { primary: str(color.primary, '#888888'), secondary: str(color.secondary, '#eeeeee') } });
+    const portrait = {
+      roleDescription: str(variant.roleDescription, str(breed.roleDescription, str(role.roleDescription))),
+      personality: str(variant.personality, str(breed.personality, str(role.personality))),
+      teamStrengths: str(variant.teamStrengths, str(breed.teamStrengths, str(role.teamStrengths))),
+      ...(Array.isArray(variant.strengths) ? { strengths: variant.strengths.filter((s: unknown) => typeof s === 'string') } : {}),
+      ...(typeof variant.caution === 'string' ? { caution: variant.caution } : {}),
+    };
+    const value = {
+      id: `seed:${id}`, name: title, nameHint: str(role.nickname, str(breed.nickname)), runtimeId,
+      breed: ['bengal', 'golden-chinchilla', 'dsh'].includes(id) || !runtimeId
+        ? { mode: 'explicit' as const, breedId: id } : { mode: 'auto' as const },
+      model: selected(variant.defaultModel), effort: selected(record(variant.cli).effort), portrait,
+      source: { kind: 'native-seed' as const, breedId: id, ...(variant.id ? { variantId: str(variant.id) } : {}) },
+    };
+    // A changed shipped default has a new CAS revision, even before a user override exists.
+    templates.push(templateSchema.parse({ ...value, revision: parseInt(botCatRequestHash(value).slice(0, 12), 16) }));
+  }
+  return { templates, breeds };
+}
+
+export function inferBotCatBreed(model: string): string | null {
+  const value = model.toLowerCase().trim();
+  const families: [string, RegExp][] = [
+    ['ragdoll', /(?:claude|\bopus\b|\bsonnet\b|\bhaiku\b|\bfable\b)/],
+    ['maine-coon', /(?:\bgpt(?:-|\b)|\bcodex\b|^o[134](?:-|$))/],
+    ['siamese', /gemini/],
+    ['dragon-li', /(?:\bglm(?:-|\b)|zhipu\/)/],
+    ['moonshot', /(?:kimi|moonshot)/],
+    ['dsh', /(?:deepseek|\bdsh\b)/],
+  ];
+  const matches = families.filter(([, pattern]) => pattern.test(value));
+  return matches.length === 1 ? matches[0][0] : null;
+}
+
+/** Mutations run under Clowder's existing catalog/file lock, never a Bot-side store. */
+export class BotCatTemplateStore {
+  readonly file: string;
+  constructor(readonly root: string, readonly source: () => unknown) { this.file = join(root, '.cat-cafe', 'bot-cat-templates.json'); }
+  private read(): State {
+    if (!existsSync(this.file)) return { version: 1, entries: {}, creations: {} };
+    // Invalid state is never replaced by fresh defaults.
+    return stateSchema.parse(JSON.parse(readFileSync(this.file, 'utf8')));
+  }
+  private write(state: State) {
+    stateSchema.parse(state);
+    mkdirSync(dirname(this.file), { recursive: true, mode: 0o700 });
+    const tmp = `${this.file}.${process.pid}.${randomUUID()}.tmp`;
+    writeFileSync(tmp, JSON.stringify(state, null, 2) + '\n', { mode: 0o600 });
+    renameSync(tmp, this.file);
+  }
+  private merged(state: State) {
+    const { templates, breeds } = botCatTemplateSeeds(this.source());
+    const known = new Set(templates.map(t => t.id));
+    const effective = templates.flatMap(t => {
+      const saved = state.entries[t.id];
+      return saved && 'deleted' in saved ? [] : [saved || t];
+    });
+    for (const [id, saved] of Object.entries(state.entries)) if (!known.has(id) && !('deleted' in saved)) effective.push(saved);
+    return { templates: effective, breeds };
+  }
+  list() { return this.merged(this.read()); }
+  get(id: string) {
+    const template = this.list().templates.find(t => t.id === id);
+    if (!template) throw new BotCatTemplateError(404, '模板不存在或已删除');
+    return template;
+  }
+  save(input: z.infer<typeof botCatTemplateInputSchema>, id?: string, expectedRevision?: number) {
+    const value = botCatTemplateInputSchema.parse(input), state = this.read();
+    const current = id ? this.merged(state).templates.find(t => t.id === id) : undefined;
+    if (id && !current) throw new BotCatTemplateError(404, '模板不存在或已删除');
+    if (current && current.revision !== expectedRevision) throw new BotCatTemplateError(409, '模板已更新，请重新打开');
+    const template = templateSchema.parse({ ...value, id: current?.id || `custom:${randomUUID()}`, revision: current ? current.revision + 1 : 1, source: current?.source || { kind: 'user' } });
+    this.validateBreed(value);
+    state.entries[template.id] = template; this.write(state);
+    return template;
+  }
+  remove(id: string, expectedRevision: number) {
+    const state = this.read(), current = this.merged(state).templates.find(t => t.id === id);
+    if (!current) throw new BotCatTemplateError(404, '模板不存在或已删除');
+    if (current.revision !== expectedRevision) throw new BotCatTemplateError(409, '模板已更新，请重新打开');
+    state.entries[id] = { deleted: true, revision: current.revision + 1 }; this.write(state);
+  }
+  validateBreed(config: BotCatConfig) {
+    if (config.breed.mode === 'explicit' && !this.list().breeds.some(b => b.id === (config.breed as { breedId: string }).breedId))
+      throw new BotCatTemplateError(422, '请选择有效猫种');
+  }
+  previous(input: BotCatCreation) {
+    const previous = this.read().creations[input.idempotencyKey];
+    if (previous && previous.requestHash !== botCatRequestHash(input)) throw new BotCatTemplateError(409, '创建请求的配置已改变，请重新创建');
+    return previous;
+  }
+  reserve(input: BotCatCreation, payload: Record<string, unknown>) {
+    const state = this.read(), previous = state.creations[input.idempotencyKey];
+    const requestHash = botCatRequestHash(input);
+    if (previous) {
+      if (previous.requestHash !== requestHash) throw new BotCatTemplateError(409, '创建请求的配置已改变，请重新创建');
+      return previous;
+    }
+    const template = input.sourceTemplate ? this.merged(state).templates.find(t => t.id === input.sourceTemplate!.id) : undefined;
+    if (input.sourceTemplate && (!template || template.revision !== input.sourceTemplate.revision)) throw new BotCatTemplateError(409, '模板已更新或删除，请重新选择');
+    const saved = { requestHash, payload, sourceTemplate: template ? { id: template.id, revision: template.revision, name: template.name } : null };
+    state.creations[input.idempotencyKey] = saved; this.write(state);
+    return saved;
+  }
+}
