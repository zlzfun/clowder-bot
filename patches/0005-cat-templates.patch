new file mode 100644
--- /dev/null
+++ b/packages/api/src/routes/bot-cat-template-routes.ts
@@ -0,0 +1,120 @@
+import { createHash } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import type { FastifyInstance, FastifyReply, FastifyRequest } from 'fastify';
+import { ZodError } from 'zod';
+import { readResolvedTemplateSource } from '../config/cat-config-loader.js';
+import {
+  BotCatTemplateError, BotCatTemplateStore, botCatInstantiateSchema, botCatTemplateInputSchema,
+  botCatTemplateUpdateSchema, botCatTemplateDeleteSchema, inferBotCatBreed, mergeBotCatTemplateSource,
+} from '../config/bot-cat-templates.js';
+import { resolveProjectTemplatePath } from '../config/project-template-path.js';
+import { withRuntimeCatMutationLock } from '../config/runtime-cat-catalog.js';
+import { resolveActiveProjectRoot } from '../utils/active-project-root.js';
+import { resolveHeaderUserId } from '../utils/request-identity.js';
+import { discoverNativeRuntimesWithReadiness } from './native-runtimes.js';
+import type { RuntimeModelCatalog } from './runtime-model-catalog.js';
+
+const creationTails = new Map<string, Promise<unknown>>();
+async function serializeCreation<T>(root: string, operation: () => Promise<T>): Promise<T> {
+  const previous = creationTails.get(root) || Promise.resolve();
+  const next = previous.catch(() => {}).then(operation);
+  creationTails.set(root, next);
+  try { return await next; } finally { if (creationTails.get(root) === next) creationTails.delete(root); }
+}
+
+export function registerBotCatTemplateRoutes(app: FastifyInstance) {
+  const store = () => {
+    const root = resolveActiveProjectRoot();
+    return new BotCatTemplateStore(root, () => mergeBotCatTemplateSource(
+      JSON.parse(readFileSync(process.env.CAT_TEMPLATE_BASE_PATH || fileURLToPath(new URL('../../../../cat-template.json', import.meta.url)), 'utf8')),
+      JSON.parse(readResolvedTemplateSource(resolveProjectTemplatePath(root))),
+    ));
+  };
+  const handle = (operation: (request: FastifyRequest, reply: FastifyReply) => unknown) => async (request: FastifyRequest, reply: FastifyReply) => {
+    if (!resolveHeaderUserId(request)) return reply.code(401).send({ error: '需要登录' });
+    try { return await operation(request, reply); }
+    catch (error) {
+      if (error instanceof BotCatTemplateError) return reply.code(error.status).send({ error: error.message });
+      if (error instanceof ZodError) return reply.code(400).send({ error: '模板配置无效', fields: error.issues.map(i => i.path.join('.')) });
+      app.log.error({ err: error }, 'Bot cat template operation failed');
+      return reply.code(500).send({ error: '无法读取或保存模板' });
+    }
+  };
+  const id = (request: FastifyRequest) => (request.params as { id: string }).id;
+  const inject = async (request: FastifyRequest, url: string, payload?: object, extra: Record<string, string> = {}) => {
+    // Reuse native authentication, model capability and member creation validation.
+    const headers = { ...request.headers, ...extra };
+    delete headers['content-length']; delete headers['transfer-encoding'];
+    const response = await app.inject({ method: payload ? 'POST' : 'GET', url, headers, ...(payload ? { payload } : {}) });
+    let result: any;
+    try { result = response.json(); } catch { throw new BotCatTemplateError(502, '原生接口返回异常'); }
+    if (response.statusCode >= 400) throw new BotCatTemplateError(response.statusCode, typeof result.error === 'string' ? result.error : '原生配置校验失败');
+    return result;
+  };
+  app.get('/api/bot-cat-templates', handle(() => store().list()));
+  app.get('/api/bot-cat-templates/:id', handle(request => ({ template: store().get(id(request)) })));
+  app.post('/api/bot-cat-templates', handle(async (request, reply) => {
+    const input = botCatTemplateInputSchema.parse(request.body), library = store();
+    const template = await withRuntimeCatMutationLock(library.root, () => library.save(input));
+    return reply.code(201).send({ template });
+  }));
+  app.put('/api/bot-cat-templates/:id', handle(async request => {
+    const { expectedRevision, ...input } = botCatTemplateUpdateSchema.parse(request.body), library = store();
+    return { template: await withRuntimeCatMutationLock(library.root, () => library.save(input, id(request), expectedRevision)) };
+  }));
+  app.delete('/api/bot-cat-templates/:id', handle(async request => {
+    const { expectedRevision } = botCatTemplateDeleteSchema.parse(request.body), library = store();
+    await withRuntimeCatMutationLock(library.root, () => library.remove(id(request), expectedRevision));
+    return { status: 'ok' };
+  }));
+  app.post('/api/bot-cat-templates/instantiate', handle(async (request, reply) => {
+    const input = botCatInstantiateSchema.parse(request.body), library = store();
+    return serializeCreation(library.root, async () => {
+      let reservation = library.previous(input);
+      if (!reservation) {
+        const config = input.catConfig;
+        if (!config.portrait.roleDescription.trim()) throw new BotCatTemplateError(422, '请填写职责');
+        library.validateBreed(config);
+        const { runtimes } = await discoverNativeRuntimesWithReadiness(library.root, true);
+        const runtime = runtimes.find(r => r.id === config.runtimeId);
+        if (!runtime || !runtime.installed) throw new BotCatTemplateError(422, '未检测到所选 Agent');
+        const supported: Record<string, string> = { claude: 'anthropic', codex: 'openai', kimi: 'kimi' };
+        if (supported[runtime.id] !== runtime.clientId || ('acp' in runtime && runtime.acp) || 'agyCarrier' in runtime)
+          throw new BotCatTemplateError(422, '所选 Agent 尚未适配');
+        if (runtime.readiness.status === 'login_required' || runtime.readiness.status === 'not_installed')
+          throw new BotCatTemplateError(422, '请先配置所选 Agent');
+        const existing = await inject(request, '/api/cats');
+        if (existing.cats.some((cat: { name: string }) => cat.name.toLowerCase() === input.name.toLowerCase()))
+          throw new BotCatTemplateError(409, '已有同名猫猫');
+        const model = config.model.mode === 'explicit' ? config.model.value : '';
+        const catalog: RuntimeModelCatalog = await inject(request, '/api/cats/runtime-models', { runtimeId: runtime.id, ...(model ? { model } : {}) });
+        const effectiveModel = model || catalog.defaultModel || ('configuredModel' in runtime ? runtime.configuredModel : '') || '';
+        const breedId = config.breed.mode === 'explicit' ? config.breed.breedId : inferBotCatBreed(effectiveModel);
+        const breed = library.list().breeds.find(b => b.id === breedId);
+        if (!breed) throw new BotCatTemplateError(422, '无法判断猫种，请手动选择');
+        const efforts = catalog.models.find(m => m.value === effectiveModel)?.efforts
+          ?? (catalog.selectedModel === effectiveModel ? catalog.effortOptions : undefined);
+        const explicitEffort = config.effort.mode === 'explicit' ? config.effort.value : null;
+        if (explicitEffort !== null && efforts !== undefined && !efforts.some(e => e.value === explicitEffort))
+          throw new BotCatTemplateError(422, efforts.length ? '该模型不支持所选推理强度' : '该模型不支持设置推理强度');
+        const catId = `bot-${createHash('sha256').update(input.idempotencyKey).digest('hex').slice(0, 24)}`;
+        const payload = {
+          catId, name: input.name, displayName: input.name, nickname: input.name, breedId: breed.id,
+          color: breed.color, mentionPatterns: [`@${input.name}`, `@${catId}`],
+          clientId: runtime.clientId, configurationSource: 'native_tool', defaultModel: model,
+          cli: { ...(runtime.command ? { command: runtime.command } : {}), effort: config.effort.mode === 'explicit' ? config.effort.value : null, defaultArgs: [] },
+          ...config.portrait,
+        };
+        // Recheck source revision inside the native file lock after asynchronous discovery.
+        reservation = await withRuntimeCatMutationLock(library.root, () => library.reserve(input, payload));
+      }
+      const journey = 'clowder-bot-template';
+      const result = await inject(request, '/api/cats', reservation.payload, {
+        'x-cat-cafe-onboarding-journey': journey,
+        'idempotency-key': `onboarding:${journey}:cat:${input.idempotencyKey}`,
+      });
+      return reply.code(201).send({ cat: result.cat, sourceTemplate: reservation.sourceTemplate });
+    });
+  }));
+}
